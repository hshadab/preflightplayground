# Required: ICME Preflight API key (server-side only, NEVER exposed to client)
ICME_API_KEY=sk-smt-...

# Compiled policy IDs. Each is captured by running:
#   npm run policy:compile -- --policy <slug>
# (and confirming the $3 spend). The script writes the slug-specific env line
# back into your .env.local automatically.
#
# If a slug is left blank, that policy still appears in the playground's
# policy library, but its presets run as deterministic replays of pre-recorded
# happy-path runs (clearly labeled "REPLAY" in the UI).
NEXT_PUBLIC_POLICY_ID_SPENDING=
NEXT_PUBLIC_POLICY_ID_REFUNDS=
NEXT_PUBLIC_POLICY_ID_DATA=
NEXT_PUBLIC_POLICY_ID_PROC=
NEXT_PUBLIC_POLICY_ID_PRICING=

# Legacy alias: if NEXT_PUBLIC_POLICY_ID_SPENDING is unset, this is used as a
# fallback for the spending policy so older deployments keep working.
NEXT_PUBLIC_POLICY_ID=

# Optional: override the API base URL (defaults to https://api.icme.io/v1)
ICME_BASE_URL=https://api.icme.io/v1

# Optional: Calendly URL shown in the "talk to founders" CTA
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min

# Required: ICME Preflight API key (server-side only, NEVER exposed to client)
ICME_API_KEY=sk-smt-...

# Required: hardcoded after one-time policy compilation
# Run `npm run policy:compile` to compile the policy and capture this value
NEXT_PUBLIC_POLICY_ID=

# Optional: override the API base URL (defaults to https://api.icme.io/v1)
ICME_BASE_URL=https://api.icme.io/v1

# Optional: Calendly URL shown in the "talk to founders" CTA
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min

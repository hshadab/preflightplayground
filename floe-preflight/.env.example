# Required: ICME Preflight API key (server-side only, NEVER exposed to client)
ICME_API_KEY=sk-smt-...

# Compiled policy IDs for the three Floe policies. Each is captured by running:
#   npm run policy:compile -- --policy <slug>
# (and confirming the $3 spend). The script writes the slug-specific env line
# back into your .env.local automatically.
#
# If a slug is left blank, that policy still appears in the demo's policy
# library, but its presets run as deterministic replays of pre-recorded
# happy-path runs (clearly labeled "REPLAY" in the UI).
NEXT_PUBLIC_POLICY_ID_BORROW=
NEXT_PUBLIC_POLICY_ID_X402=
NEXT_PUBLIC_POLICY_ID_LIQ=

# Optional: override the API base URL (defaults to https://api.icme.io/v1)
ICME_BASE_URL=https://api.icme.io/v1

# Optional: Calendly URL shown in the "talk to founders" CTA
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min

# Optional: canonical site URL used for OG / Twitter image absolute paths
NEXT_PUBLIC_SITE_URL=https://floe-preflight.vercel.app
